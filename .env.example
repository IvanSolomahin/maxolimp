# Скопируй в .env и заполни реальными значениями.

# ─── task-db ────────────────────────────────────────────
TASK_DB_USER=gazprompt
TASK_DB_PASSWORD=change_me
TASK_DB_NAME=gazprompt

# ─── olymp-db ───────────────────────────────────────────
OLYMP_DB_USER=olymp
OLYMP_DB_PASSWORD=change_me
OLYMP_DB_NAME=olymp

# ─── task-app: эмбеддинги ───────────────────────────────
# AITunnel: https://aitunnel.ru/models/qwen3-embedding-4b
AITUNNEL_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-4b
EMBEDDING_DIMENSION=2560

MAX_BOT_TOKEN=tokenbot
FRONTEND_URL=bot_name
MAX_WEBHOOK_SECRET=very_secret_line

GIGACHAT_CREDENTIALS=gigachat_key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
