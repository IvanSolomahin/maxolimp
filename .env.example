# Скопируй в .env и заполни реальными значениями.

# ─── task-db ────────────────────────────────────────────
TASK_DB_USER=gazprompt
TASK_DB_PASSWORD=change_me
TASK_DB_NAME=gazprompt

# ─── olymp-db ───────────────────────────────────────────
OLYMP_DB_USER=olymp
OLYMP_DB_PASSWORD=change_me
OLYMP_DB_NAME=olymp

# ─── task-app: эмбеддинги ───────────────────────────────
# e5-large = 1024, e5-base = 768, e5-small = 384
# При смене модели нужно переиндексировать все вектора в БД!
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_MODEL_VERSION=1.0
EMBEDDING_DIMENSION=1024

# ─── olymp-app ──────────────────────────────────────────
DEFAULT_USER_ID=1